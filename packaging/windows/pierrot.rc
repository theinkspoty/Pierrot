#include <windows.h>
#include <winver.h>

IDI_ICON1 ICON "pierrot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Pierrot"
            VALUE "FileDescription", "Editor de video estilo Vegas Pro"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Pierrot"
            VALUE "ProductVersion", "0.1.0"
            VALUE "InternalName", "pierrot"
            VALUE "OriginalFilename", "pierrot.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
